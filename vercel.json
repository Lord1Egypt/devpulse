{
  "version": 2,
  "builds": [
    {
      "src": "api/stats.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30 }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "index.css", "use": "@vercel/static" },
    { "src": "index.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/stats", "dest": "api/stats.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
